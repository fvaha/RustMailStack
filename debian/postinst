#!/bin/sh
set -e

case "$1" in
  configure)
    # service accounts
    getent group stalwart >/dev/null || addgroup --system stalwart
    getent passwd stalwart >/dev/null || adduser --system --ingroup stalwart         --home /var/lib/stalwart --no-create-home --shell /usr/sbin/nologin stalwart
    getent group iris >/dev/null || addgroup --system iris
    getent passwd iris >/dev/null || adduser --system --ingroup iris         --home /var/lib/iris --no-create-home --shell /usr/sbin/nologin iris

    install -d -o stalwart -g stalwart -m 750 /var/lib/stalwart /var/log/stalwart /etc/stalwart
    install -d -o iris      -g iris      -m 750 /var/lib/iris
    install -d -o root      -g root      -m 755 /opt/iris /srv/iris /etc/iris /etc/mailstack
    chown -R root:root /srv/iris

    # IRIS env on first install only (keeps the session secret across upgrades)
    if [ ! -f /etc/iris/iris.env ]; then
      umask 077
      cat > /etc/iris/iris.env <<EOF
IRIS_ENV=production
IRIS_HOST=127.0.0.1
IRIS_PORT=\${IRIS_PORT:-8000}
STALWART_API_URL=http://127.0.0.1:8080
DATABASE_URL=sqlite:/var/lib/iris/iris.db
SESSION_SECRET=$(openssl rand -hex 32)
SEND_LOCAL_DOMAINS=\${MAIL_DOMAIN:-}
SEND_EXTERNAL=true
IRIS_INTEGRATION_EMAIL_ENABLED=false
TEMP_INBOX_DOMAIN=
# Comma-separated allow-list for the admin dashboard (#/admin). Empty = nobody.
IRIS_ADMIN_EMAILS=
EOF
      chown root:iris /etc/iris/iris.env
      chmod 640 /etc/iris/iris.env
    fi

    # deployment values template
    if [ ! -f /etc/mailstack/mailstack.env ]; then
      cp /etc/mailstack/mailstack.env.example /etc/mailstack/mailstack.env
      chmod 600 /etc/mailstack/mailstack.env
    fi

    # white-label branding: seeded once, then owned by the admin (never overwritten)
    if [ ! -f /etc/iris/branding.json ] && [ -f /etc/iris/branding.json.example ]; then
      cp /etc/iris/branding.json.example /etc/iris/branding.json
      chmod 644 /etc/iris/branding.json
    fi

    # certificate follow-up: daily, only restarts Stalwart when the cert changes
    printf '17 4 * * *\troot\t/usr/local/sbin/mailstack-cert-sync\n' > /etc/cron.d/mailstack-cert
    chmod 644 /etc/cron.d/mailstack-cert

    # unattended Stalwart provisioning on a fresh install: one domain, admin
    # account, TLS certificate object and the DNS zone file. Interactive
    # installs get a single question; anything non-interactive falls back to
    # the setup wizard, which is also what upgrades keep doing.
    PROVISIONED=0
    if [ -z "${2:-}" ] && [ "${MAILSTACK_SKIP_PROVISION:-0}" != "1" ]; then
      # shellcheck disable=SC1091
      _pre_domain="${MAIL_DOMAIN:-}"
      . /etc/mailstack/mailstack.env 2>/dev/null || true
      DOMAIN="${MAILSTACK_DOMAIN:-${_pre_domain:-${MAIL_DOMAIN:-}}}"
      if [ -z "$DOMAIN" ] || [ "$DOMAIN" = "example.com" ]; then
        if [ -t 0 ]; then
          printf 'Mail domain for this server (empty = finish in the Stalwart wizard): '
          read -r DOMAIN
        fi
      fi
      case "$DOMAIN" in
        ""|example.com) : ;;
        *)
          echo "Provisioning Stalwart for $DOMAIN ..."
          if MAIL_DOMAIN="$DOMAIN" MAIL_HOST="mail.$DOMAIN" /usr/local/sbin/mailstack-provision; then
            PROVISIONED=1
            sed -i -e "s|^MAIL_DOMAIN=.*|MAIL_DOMAIN=$DOMAIN|" \
                   -e "s|^MAIL_HOST=.*|MAIL_HOST=mail.$DOMAIN|" \
                   -e "s|^WEBMAIL_HOST=.*|WEBMAIL_HOST=webmail.$DOMAIN|" \
                   /etc/mailstack/mailstack.env
          else
            echo "Provisioning failed; finish setup in the wizard: http://127.0.0.1:8080/admin"
          fi
          ;;
      esac
    fi

    systemctl daemon-reload || true
    systemctl enable --now stalwart.service || true
    systemctl enable --now iris.service || true
    systemctl enable --now mailstack-cleanup.timer || true

    # shellcheck disable=SC1091
    [ -f /etc/mailstack/mailstack.env ] && . /etc/mailstack/mailstack.env
    MAIL_HOST="${MAIL_HOST:-<MAIL_HOST>}"
    WEBMAIL_HOST="${WEBMAIL_HOST:-<WEBMAIL_HOST>}"

    echo
    echo "RustMailStack installed."
    echo "  1. edit /etc/mailstack/mailstack.env (MAIL_HOST, WEBMAIL_HOST, MAIL_DOMAIN)"
    if [ "$PROVISIONED" = 1 ]; then
      echo "     Stalwart is already provisioned for $DOMAIN"
      echo "     admin credentials: /etc/mailstack/admin.credentials (mode 600)"
      echo "     DNS records to publish: /etc/mailstack/dns-zone.txt"
      sed -n '1,12p' /etc/mailstack/dns-zone.txt 2>/dev/null || true
    else
      echo "  2. open the Stalwart setup wizard: http://127.0.0.1:8080/admin"
      echo "     (tunnel it: ssh -N -L 8080:127.0.0.1:8080 <server>)"
    fi
    echo "  3. add $MAIL_HOST / $WEBMAIL_HOST to Caddy: import /etc/caddy/mailstack.caddy"
    echo "  4. branding (optional): /etc/iris/branding.json, name, logo, colours, links"
    echo "  5. verify: /usr/local/sbin/mailstack-health"
    echo
    ;;
esac

exit 0
