# RustMailStack — include this from your Caddyfile:
#   import /etc/caddy/mailstack.caddy
# Values come from the Caddy service environment (mailstack.env loaded by a drop-in).

{$MAIL_HOST} {
    reverse_proxy 127.0.0.1:8080
}

{$WEBMAIL_HOST} {
    encode zstd gzip

    @backend path /api/* /auth/* /health
    handle @backend {
        reverse_proxy 127.0.0.1:{$IRIS_PORT} {
            header_up X-Real-IP {remote_host}
        }
    }

    handle {
        root * /srv/iris/dist
        @hashed path /assets/*
        header @hashed Cache-Control "public, max-age=31536000, immutable"
        @revalidate not path /assets/*
        header @revalidate Cache-Control "no-cache"
        file_server
    }

    handle_errors 404 {
        root * /srv/iris/dist
        rewrite * /404.html
        file_server
    }
}
