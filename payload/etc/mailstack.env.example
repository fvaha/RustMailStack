# RustMailStack — deployment values. Copy to /etc/mailstack/mailstack.env
MAIL_HOST=mail.example.com          # Stalwart hostname (also the admin UI host)
WEBMAIL_HOST=webmail.example.com    # IRIS host
MAIL_DOMAIN=example.com             # first mail domain
CF_API_TOKEN=                       # optional: publishes MX/SPF/DKIM/DMARC automatically
IRIS_PORT=8000
